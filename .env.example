# 테넌트 선택 (tenants/ 폴더의 yaml 파일명)
# 사용 가능: naechinso, moneywalk
TENANT=naechinso

# OpenAI (필수)
OPENAI_API_KEY=your_openai_api_key_here

# Google Play Console
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=service_account.json
# yaml의 기본 패키지명을 덮어쓰려면 환경변수 설정 (선택)
# GOOGLE_PLAY_PACKAGE_NAME_KOR=com.your.package

# App Store Connect
APP_STORE_PRIVATE_KEY_PATH=AuthKey_XXXXXX.p8
APP_STORE_KEY_ID=your_key_id
APP_STORE_ISSUER_ID=your_issuer_id
# yaml의 기본 번들 ID를 덮어쓰려면 환경변수 설정 (선택)
# APP_STORE_BUNDLE_ID_KOR=com.your.bundle
